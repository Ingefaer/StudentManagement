@model Student

<h1>Edit Student</h1>

<form asp-action="EditStudent" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="form-group mb-3">
        <label>Navn:</label><br />
        <input type="text" asp-for="Name" />
    </div>

    <div class="form-group mb-3">
        <label>Uddannelse:</label><br />
        <input type="text" asp-for="Education" />
    </div>

    <div class="form-group mb-3">
        <label>Semester:</label><br />
        <select asp-for="Semester" asp-items="@Model.semesters()" class="form-select w-auto mx-auto">
           
        </select>
    </div>

    <div class="form-group mb-3">
        <label>Email:</label><br />
        <input type="email" asp-for="Email" />
    </div>

    <div class="form-group mb-3">
        <button asp-action="EditStudent" class="btn btn-primary">Gem</button>
    </div>

    <div asp-validation-summary="All" class="text-danger"></div>

</form>