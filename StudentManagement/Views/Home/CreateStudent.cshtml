@model StudentManagement.Models.Student


<h2>Opret ny studerende</h2>

<form asp-action="CreateStudent" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="form-group mb-3">
        <label>Navn:</label><br />
        <input type="text" asp-for="Name" />
    </div>

    <div class="form-group mb-3">
        <label>Uddannelse:</label><br />
        <input type="text" asp-for="Education" />
   </div>

   <div class="form-group mb-3">
        <label>Semester:</label><br />
        <select asp-for="Semester" asp-items="@Model.semesters()" class="form-select w-auto mx-auto">
            <option value="">-- Vælg et semester --</option>
        </select>
   </div>

   <div class="form-group mb-3">
        <label>Email:</label><br />
        <input type="email" asp-for="Email" />
   </div>

   <div class="form-group mb-3">
        <button asp-action="CreateStudent" class="btn btn-primary">Gem</button>
    </div>

    <div asp-validation-summary="All" class="text-danger"></div>

</form>