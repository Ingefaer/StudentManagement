@model IEnumerable<StudentManagement.Models.Student> 
<h1>Student Management:</h1>

<table class="table">

    <thead>
        <th>Id</th>
        <th>Navn</th>
        <th>Uddannelse</th>
        <th>Semester</th>
        <th>Email</th>
        <th>Indstillinger</th>
    </thead>

    <tbody>
        @foreach (var Student in Model)
        {
            <tr>
                <td>@Student.Id</td>
                <td>@Student.Name</td>
                <td>@Student.Education</td>
                <td>@Student.Semester</td>
                <td>@Student.Email</td>
                <td>
                    <a asp-action="EditStudent" asp-route-id="@Student.Id" class="btn btn-secondary btn-lg">Edit</a>
                    <a asp-action="DeleteStudent" asp-route-id="@Student.Id" class="btn btn-danger btn-lg">Delete</a>
                </td>
            </tr>
        }

    </tbody>

</table>


<br />
<a asp-action="CreateStudent" class="btn btn-primary btn-lg">Create Student</a>